{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --define \"NG_API_BASE_URL='$NG_API_BASE_URL'\"",
    "build": "ng build --define \"NG_API_BASE_URL='$NG_API_BASE_URL'\"",
    "watch": "ng build --watch --configuration development --define \"NG_API_BASE_URL='$NG_API_BASE_URL'\"",
    "test": "ng test",
    "api:types": "openapi-typescript \"$NG_API_BASE_URL/v3/api-docs\" -o src/app/api/schema.d.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^1.0.2",
    "@openng/optimus-ui-tailwindcss": "^1.0.2",
    "@openng/optimus-ui-themes": "^1.0.2",
    "@stomp/stompjs": "^7.3.0",
    "keycloak-angular": "^21.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
